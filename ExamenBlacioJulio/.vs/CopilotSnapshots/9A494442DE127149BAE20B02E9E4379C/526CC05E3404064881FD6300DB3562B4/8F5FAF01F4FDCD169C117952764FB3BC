using System;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Windows.Forms;

namespace ExamenBlacioJulio
{
    public partial class FrmMargarita : Form
    {
        private float ladoBase;
        private float escala = 1f;

        public FrmMargarita()
        {
            InitializeComponent();
            trackBar1.Minimum = 2;
            trackBar1.Maximum = 30;
            trackBar1.Value = 10;
            trackBar1.TickFrequency = 2;
            lblEscalaValor.Text = "1.0x";
        }

        private void BtnCalcular_Click(object sender, EventArgs e)
        {
            if (!float.TryParse(txtAncho.Text, out ladoBase) || ladoBase <= 0)
            {
                MessageBox.Show("Ingresa un tamaño válido mayor que 0.");
                return;
            }

            lblResultado.Text = $"Tamaño base: {ladoBase:0.##}";
            pnlCanvas.Invalidate();
        }

        private void BtnResetear_Click(object sender, EventArgs e)
        {
            txtAncho.Clear();
            lblResultado.Text = "Tamaño base:";
            ladoBase = 0;
            escala = 1f;
            trackBar1.Value = 10;
            lblEscalaValor.Text = "1.0x";
            pnlCanvas.Invalidate();
        }

        private void BtnSalir_Click(object sender, EventArgs e)
        {
            Close();
        }

        private void trackBar1_Scroll(object sender, EventArgs e)
        {
            escala = trackBar1.Value / 10f;
            lblEscalaValor.Text = $"{escala:0.0}x";
            pnlCanvas.Invalidate();
        }

        private void pnlCanvas_Paint(object sender, PaintEventArgs e)
        {
            Graphics g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;
            g.Clear(Color.White);

            if (ladoBase <= 0)
            {
                using (Font f = new Font("Segoe UI", 11f, FontStyle.Regular))
                using (Brush b = new SolidBrush(Color.Gray))
                {
                    g.DrawString("Ingresa el tamaño y presiona Calcular.", f, b, 15, 15);
                }
                return;
            }

            float squareSize = Math.Min(pnlCanvas.Width, pnlCanvas.Height) * 0.78f;
            RectangleF square = new RectangleF(
                (pnlCanvas.Width - squareSize) / 2f,
                (pnlCanvas.Height - squareSize) / 2f,
                squareSize,
                squareSize);

            PointF center = new PointF(square.Left + square.Width / 2f, square.Top + square.Height / 2f);

            float sidePixels = ladoBase * 11f * escala;
            float petalRadiusFromInput = sidePixels / (2f * (float)Math.Sin(Math.PI / 5f));
            float petalRadiusMax = squareSize * 0.21f;
            float petalRadius = Math.Min(petalRadiusFromInput, petalRadiusMax);

            float bigPentagonRadius = petalRadius * 2.05f;
            float petalCentersRadius = bigPentagonRadius - petalRadius;

            using (Pen border = new Pen(Color.Gray, 2f))
            using (Pen petalBorder = new Pen(Color.Black, 2f))
            using (Brush red = new SolidBrush(Color.Red))
            {
                g.DrawRectangle(border, square.X, square.Y, square.Width, square.Height);

                for (int i = 0; i < 5; i++)
                {
                    float angle = -90f + (i * 72f);
                    PointF petalCenter = PolygonGeometry.PointOnCircle(center, petalCentersRadius, angle);
                    PointF[] petal = PolygonGeometry.CreateRegularPolygon(petalCenter, petalRadius, 5, angle);

                    g.FillPolygon(red, petal);
                    g.DrawPolygon(petalBorder, petal);
                }
            }
        }
    }
}
